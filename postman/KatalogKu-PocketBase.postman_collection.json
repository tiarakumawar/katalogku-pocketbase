  "item": [
    {
      "name": "1. Produk (product-service)",
      "item": [
        {
          "name": "Cek gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Daftar produk",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?perPage=5&sort=-created",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "perPage",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "-created"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "// simpan id produk pertama untuk request berikutnya",
                  "pm.collectionVariables.set(\"productId\", pm.response.json().items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cari produk",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?filter=title~'kopi'",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "title~'kopi'"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail produk",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Akun (account-service)",
      "item": [
        {
          "name": "Daftar akun",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/records",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "records"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi\",\n  \"email\": \"budi@itb.ac.id\",\n  \"password\": \"rahasia123\",\n  \"passwordConfirm\": \"rahasia123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 200 = akun baru, 400 = email sudah terdaftar (lanjut login saja)",
                  "pm.test(\"Status 200/400\", () => pm.expect(pm.response.code).to.be.oneOf([200,400]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (simpan token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/auth-with-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "auth-with-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"budi@itb.ac.id\",\n  \"password\": \"rahasia123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const hasil = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", hasil.token);",
                  "pm.collectionVariables.set(\"userId\", hasil.record.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Favorit (account-service)",
      "item": [
        {
          "name": "Tambah favorit",
          "request": {
            "method": "POST",
            "header": [
