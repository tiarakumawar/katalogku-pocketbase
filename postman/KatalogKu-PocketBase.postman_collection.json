              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "favorites",
                "{{favId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.expect(pm.response.code).to.be.oneOf([204]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
